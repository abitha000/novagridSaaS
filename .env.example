# Copy to .env.local (git-ignored). These two values are PUBLIC by design (protected by RLS).
# If omitted, the app falls back to utils/supabase/info.tsx (autogenerated by the Supabase connection).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# NEVER add SUPABASE_SERVICE_ROLE_KEY, database passwords, payment secrets or WhatsApp/SMS tokens here.
# Anything prefixed VITE_ is bundled into the browser. Server secrets live only in Supabase Edge Function
# secrets (supabase secrets set ...) or Supabase Vault.
